{
  "name": "azure-sdk-qa-bot-mcp-server",
  "version": "0.1.0",
  "description": "MCP server with a tool to call the completion API of azure-sdk-qa-bot-backend",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "azure-sdk-qa-bot-mcp-server": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "test": "ts-node src/test.ts",
    "test:mcp": "npm run build && node dist/test-mcp.js",
    "test:build": "npm run build && node dist/test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.6",
    "axios": "^1.6.0",
    "@types/node": "^20.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "tsx": "^4.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
